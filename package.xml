<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmtc_bot</name>
  <version>0.1.0</version>
  <description>RMTC 图灵对决赛参赛程序骨架：stage1 采集 / stage2 任务与对抗</description>
  <maintainer email="contestant@example.com">contestant</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 通信：只用 std_msgs/String 装 JSON，不需要自定义消息 -->
